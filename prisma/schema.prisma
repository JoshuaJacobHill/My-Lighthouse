// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentication ───────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users & Roles ────────────────────────────────────────────────────────────

enum UserRole {
  VOLUNTEER
  ADMIN
  SUPER_ADMIN
  KIOSK
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  role          UserRole  @default(VOLUNTEER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  accounts            Account[]
  sessions            UserSession[]
  volunteerProfile    VolunteerProfile?
  adminNotes          AdminNote[]          @relation("NoteCreatedBy")
  emailLogs           EmailLog[]           @relation("EmailSentBy")
  passwordResetTokens PasswordResetToken[]

  // Donor & fundraising (additive — see docs/donor-portal-plan.md)
  donorProfile DonorProfile?
  donations    Donation[]
  sponsorships Sponsorship[]
  ticketOrders TicketOrder[]
}

// ─── Volunteer Profiles ───────────────────────────────────────────────────────

enum VolunteerStatus {
  PENDING_INDUCTION
  INDUCTED // legacy — no longer assigned; kept for DB compat
  ACTIVE
  INACTIVE
  ON_LEAVE // replaces PAUSED — volunteer-requested break
  PAUSED // legacy — no longer assigned; kept for DB compat
  SUSPENDED // admin-imposed hold (conduct, blue card, etc.)
  REMOVED
}

enum BlueCardStatus {
  NOT_APPLICABLE
  PENDING
  CURRENT
  EXPIRED
}

model VolunteerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personal details
  firstName    String
  lastName     String
  email        String
  mobile       String
  dateOfBirth  DateTime?
  addressLine1 String?
  addressLine2 String?
  suburb       String?
  state        String?
  postcode     String?

  // Emergency contact
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Status
  status            VolunteerStatus @default(PENDING_INDUCTION)
  joinedAt          DateTime        @default(now())
  lastActiveAt      DateTime?
  lastAttendedAt    DateTime?
  deactivatedAt     DateTime?
  deactivatedReason String?

  // Preferences
  preferredLocations String[]
  areasOfInterest    String[]
  notes              String?  @db.Text
  medicalNotes       String?  @db.Text
  accessibilityNeeds String?  @db.Text

  // Blue Card
  blueCardStatus BlueCardStatus @default(NOT_APPLICABLE)
  blueCardNumber String?
  blueCardExpiry DateTime?

  // Consents
  agreedToTerms       Boolean   @default(false)
  agreedToPrivacy     Boolean   @default(false)
  consentEmailUpdates Boolean   @default(false)
  consentSmsUpdates   Boolean   @default(false)
  agreedAt            DateTime?

  avatarUrl        String?
  inductionAnswers Json?

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability      VolunteerAvailability[]
  inductionProgress InductionProgress[]
  shiftAssignments  ShiftAssignment[]
  recurringBookings RecurringBooking[]
  attendanceRecords AttendanceRecord[]
  adminNotes        AdminNote[]
  emailLogs         EmailLog[]
  quizAnswers       InductionQuizAnswer[]

  @@index([status])
  @@index([lastAttendedAt])
  @@index([email])
}

// ─── Availability ─────────────────────────────────────────────────────────────

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimePeriod {
  PRE_OPEN // before 9:00 am
  MORNING // 9:00 am – 12:30 pm
  AFTERNOON // 12:30 pm onwards
  EVENING // kept for legacy compat
}

model VolunteerAvailability {
  id          String     @id @default(cuid())
  volunteerId String
  dayOfWeek   DayOfWeek
  timePeriod  TimePeriod // computed from startTime for display grouping
  startTime   String     @default("09:00") // HH:MM 24-hour, e.g. "09:00"
  endTime     String     @default("12:00") // HH:MM 24-hour, e.g. "12:00"
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, dayOfWeek, startTime])
  @@index([volunteerId])
}

// ─── Locations & Departments ──────────────────────────────────────────────────

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts            Shift[]
  attendance        AttendanceRecord[]
  guestAttendance   GuestAttendanceRecord[]
  recurringBookings RecurringBooking[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts Shift[]
}

// ─── Induction ────────────────────────────────────────────────────────────────

model InductionSection {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  sortOrder  Int      @default(0)
  isRequired Boolean  @default(true)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  progress InductionProgress[]
}

model InductionProgress {
  id          String    @id @default(cuid())
  volunteerId String
  sectionId   String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  section   InductionSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, sectionId])
}

model InductionQuizQuestion {
  id        String   @id @default(cuid())
  question  String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options InductionQuizOption[]
  answers InductionQuizAnswer[]
}

model InductionQuizOption {
  id         String  @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean @default(false)
  sortOrder  Int     @default(0)

  question InductionQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  InductionQuizAnswer[]
}

model InductionQuizAnswer {
  id          String   @id @default(cuid())
  volunteerId String
  questionId  String
  optionId    String
  isCorrect   Boolean
  answeredAt  DateTime @default(now())

  volunteer VolunteerProfile      @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  question  InductionQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option    InductionQuizOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, questionId])
}

// ─── Shifts & Rostering ───────────────────────────────────────────────────────

enum RecurringFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum ShiftAssignmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED_BY_VOLUNTEER
  ATTENDED
  NO_SHOW
  ADMIN_CANCELLED
}

model Shift {
  id           String   @id @default(cuid())
  locationId   String
  departmentId String?
  title        String?
  date         DateTime
  startTime    DateTime
  endTime      DateTime
  capacity     Int      @default(1)
  isRecurring  Boolean  @default(false)
  recurringId  String?
  notes        String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?

  location    Location          @relation(fields: [locationId], references: [id])
  department  Department?       @relation(fields: [departmentId], references: [id])
  assignments ShiftAssignment[]

  @@index([date])
  @@index([locationId])
}

model ShiftAssignment {
  id           String                @id @default(cuid())
  shiftId      String
  volunteerId  String
  status       ShiftAssignmentStatus @default(SCHEDULED)
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  createdById  String?

  shift     Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([shiftId, volunteerId])
  @@index([status])
}

// A volunteer's standing/recurring shift preference.
// When the cron generates new shifts it auto-books any active RecurringBookings
// that match the new shift's location, title and day of week.
model RecurringBooking {
  id          String             @id @default(cuid())
  volunteerId String
  locationId  String
  shiftTitle  String // e.g. "Morning Shift"
  dayOfWeek   Int // 1=Mon … 6=Sat (UTC day of the anchor shift)
  anchorDate  DateTime // Date of the first booked shift — used to calculate fortnightly/monthly cadence
  frequency   RecurringFrequency
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  location  Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@index([isActive])
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model AttendanceRecord {
  id           String    @id @default(cuid())
  volunteerId  String
  locationId   String?
  shiftId      String?
  signInAt     DateTime  @default(now())
  signOutAt    DateTime?
  durationMins Int?
  kioskName    String?
  ipAddress    String?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  location  Location?        @relation(fields: [locationId], references: [id])

  @@index([volunteerId])
  @@index([signInAt])
  @@index([locationId])
}

model GuestAttendanceRecord {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  mobile             String?
  email              String?
  volunteerArea      String?
  organisation       String?
  isCorporateDay     Boolean   @default(false)
  emergencyContact   String?
  safetyAcknowledged Boolean   @default(false)
  locationId         String?
  signInAt           DateTime  @default(now())
  signOutAt          DateTime?
  durationMins       Int?
  kioskName          String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  location Location? @relation(fields: [locationId], references: [id])

  @@index([signInAt])
}

// ─── Admin Notes ──────────────────────────────────────────────────────────────

model AdminNote {
  id          String   @id @default(cuid())
  volunteerId String
  content     String   @db.Text
  isInternal  Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  createdBy User             @relation("NoteCreatedBy", fields: [createdById], references: [id])
}

// ─── Email System ─────────────────────────────────────────────────────────────

enum EmailTemplateType {
  SIGNUP_CONFIRMATION
  INDUCTION_REMINDER
  INDUCTION_COMPLETE
  SHIFT_BOOKED
  VOLUNTEER_WELCOME
  SHIFT_REMINDER
  SHIFT_CANCELLED
  MISSED_SHIFT_FOLLOWUP
  INACTIVITY_CHECKIN
  ADMIN_NEW_VOLUNTEER
  ADMIN_REPEATED_NOSHOWS
  CUSTOM
}

model EmailTemplate {
  id        String            @id @default(cuid())
  type      EmailTemplateType @unique
  name      String
  subject   String
  bodyHtml  String            @db.Text
  bodyText  String?           @db.Text
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

model EmailLog {
  id           String             @id @default(cuid())
  to           String
  subject      String
  templateType EmailTemplateType?
  status       EmailStatus        @default(PENDING)
  sentAt       DateTime?
  errorMsg     String?
  volunteerId  String?
  sentById     String?
  metadata     Json?
  createdAt    DateTime           @default(now())

  volunteer VolunteerProfile? @relation(fields: [volunteerId], references: [id])
  sentBy    User?             @relation("EmailSentBy", fields: [sentById], references: [id])

  @@index([volunteerId])
  @@index([sentAt])
}

// ─── Password Reset ───────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── App Settings ─────────────────────────────────────────────────────────────

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  label     String?
  group     String?
  updatedAt DateTime @updatedAt

  @@index([group])
}

// ════════════════════════════════════════════════════════════════════════════
// DONOR & FUNDRAISING PORTAL
//
// All models below are ADDITIVE. They do not change any existing table and are
// not referenced by the volunteer portal, kiosk, or attendance features.
// Blueprint: docs/donor-portal-plan.md
// ════════════════════════════════════════════════════════════════════════════

enum DonationSource {
  DONATE_PAGE
  FUNDRAISER
  WORDPRESS_FORM
  APPEAL_LINK
  EVENT
  OFFLINE // manually recorded / imported (e.g. migrated from ShoutForGood)
}

enum SponsorshipStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum TicketOrderStatus {
  CONFIRMED
  CANCELLED
  REFUNDED
}

// ─── Donor profile (one per donor, optional) ──────────────────────────────────

model DonorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  displayName         String?
  phone               String?
  address             String?
  consentEmailUpdates Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Fund / designation (where the money goes) ────────────────────────────────

model Fund {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true)
  // When true, the public progress widget (raised vs goal) may be embedded for
  // this fund on lighthousecare.org.au. Independent of isActive so totals can be
  // shown/hidden without affecting whether the fund accepts gifts.
  showPublicProgress Boolean @default(false)
  goalAmount  Decimal?  @db.Decimal(10, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  donations    Donation[]
  fundraisers  Fundraiser[]
  events       Event[]
  sponsorships Sponsorship[]

  @@index([isActive])
}

// ─── Donation (one row per completed gift) ────────────────────────────────────

model Donation {
  id                  String         @id @default(cuid())
  userId              String? // null until matched to an account by email
  donorEmail          String
  donorName           String?
  message             String?        @db.Text // optional public message shown on the donor wall
  amount              Decimal        @db.Decimal(10, 2)
  currency            String         @default("AUD")
  // Payment provider for this gift (e.g. STRIPE). Kept provider-neutral so a
  // gateway can change without a schema migration.
  provider              String       @default("STRIPE")
  // Null for offline / imported gifts (no gateway transaction). Unique when set.
  providerTransactionId String?      @unique
  fundId              String? // reconcilable; defaults to General once seeded
  fundraiserId        String?
  sponsorshipId       String?
  isRecurring         Boolean        @default(false)
  source              DonationSource @default(DONATE_PAGE)
  taxReceiptEligible  Boolean        @default(true)
  taxReceiptIssued    Boolean        @default(false)
  createdAt           DateTime       @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fund        Fund?        @relation(fields: [fundId], references: [id], onDelete: SetNull)
  fundraiser  Fundraiser?  @relation(fields: [fundraiserId], references: [id], onDelete: SetNull)
  sponsorship Sponsorship? @relation(fields: [sponsorshipId], references: [id], onDelete: SetNull)

  @@index([donorEmail])
  @@index([userId])
  @@index([fundId])
  @@index([fundraiserId])
  @@index([createdAt])
}

// ─── Sponsorship (recurring commitment) ───────────────────────────────────────

model Sponsorship {
  id                   String            @id @default(cuid())
  userId               String
  amount               Decimal           @db.Decimal(10, 2)
  frequency            String            @default("MONTHLY")
  fundId               String?
  provider             String            @default("STRIPE")
  // Provider reference for the recurring arrangement — with Stripe, the Stripe
  // Billing subscription id (native recurring; no scheduler of our own needed).
  providerSubscriptionRef String?        @unique
  status               SponsorshipStatus @default(ACTIVE)
  startedAt            DateTime          @default(now())
  cancelledAt          DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund      Fund?      @relation(fields: [fundId], references: [id], onDelete: SetNull)
  donations Donation[]

  @@index([userId])
  @@index([status])
}

// ─── Fundraiser (GoFundMe-style page) ─────────────────────────────────────────

model Fundraiser {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  storyHeading   String?   // optional heading above the story (e.g. "Building with Purpose")
  story          String    @db.Text
  contentBlocks  Json?     // rich sections below the story (image+text, video) — see the public page
  imageUrl       String?
  goalAmount     Decimal?  @db.Decimal(10, 2)
  raisedAmount   Decimal   @default(0) @db.Decimal(10, 2)
  organiserName  String
  organiserEmail String?
  fundId         String
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fund      Fund       @relation(fields: [fundId], references: [id])
  donations Donation[]

  @@index([fundId])
  @@index([isActive])
}

// ─── Event ticketing ──────────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @db.Text
  imageUrl    String?
  venue       String?
  startsAt    DateTime
  endsAt      DateTime?
  fundId      String?
  capacity    Int?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fund        Fund?         @relation(fields: [fundId], references: [id], onDelete: SetNull)
  ticketTypes TicketType[]
  orders      TicketOrder[]

  @@index([fundId])
  @@index([isPublished])
}

model TicketType {
  id                String    @id @default(cuid())
  eventId           String
  name              String
  price             Decimal   @db.Decimal(10, 2)
  quantityAvailable Int?
  maxPerOrder       Int?
  salesStartAt      DateTime?
  salesEndAt        DateTime?
  sortOrder         Int       @default(0)

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([eventId])
}

model TicketOrder {
  id                  String            @id @default(cuid())
  userId              String? // matched by email
  purchaserName       String
  purchaserEmail      String
  eventId             String
  amountTotal         Decimal           @db.Decimal(10, 2)
  provider            String            @default("STRIPE")
  providerTransactionId String?         @unique
  status              TicketOrderStatus @default(CONFIRMED)
  createdAt           DateTime          @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([eventId])
  @@index([purchaserEmail])
  @@index([userId])
}

model Ticket {
  id           String    @id @default(cuid())
  orderId      String
  ticketTypeId String
  attendeeName String?
  reference    String    @unique
  checkedInAt  DateTime?

  order      TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@index([ticketTypeId])
}

// ─── Webhook audit / idempotency ──────────────────────────────────────────────

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String    @default("STRIPE")
  eventType       String
  providerEventId String    @unique
  payload         Json
  processedAt     DateTime?
  error           String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([provider])
  @@index([processedAt])
}
