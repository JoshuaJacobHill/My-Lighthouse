// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentication ───────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Donor migration (e.g. from Shout for Good) ───────────────────────────────
//
// A pending "re-confirm your card" intent for a recurring donor we're moving
// across from another platform. Cards can't be transferred, so we email the
// donor a tokenised link that pre-fills their name/company/amount/frequency and
// asks only for their card. Completing it creates a normal Stripe subscription.
model MigrationIntent {
  id             String    @id @default(cuid())
  token          String    @unique // for the re-confirm link (no PII in URL)
  email          String
  donorName      String?
  donorCompany   String?
  amountCents    Int
  frequency      String // weekly | fortnightly | monthly
  fundSlug       String
  source         String    @default("shout_for_good")
  status         String    @default("PENDING") // PENDING | COMPLETED | CANCELLED
  emailSentAt    DateTime? // when the re-confirm email was last sent
  completedAt    DateTime?
  subscriptionId String? // Stripe subscription created on completion
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([status])
}

// A reusable Stripe customer per donor, per Stripe account (CARE/CHURCH), so we
// can save their card on file and offer one-tap giving next time. We never store
// card data — only Stripe's customer id; the card lives in Stripe's vault.
model StripeCustomer {
  id         String   @id @default(cuid())
  userId     String
  account    String // CARE | CHURCH — customers are scoped to a Stripe account
  customerId String
  createdAt  DateTime @default(now())

  @@unique([userId, account])
  @@index([userId])
}

// ─── Users & Roles ────────────────────────────────────────────────────────────

enum UserRole {
  VOLUNTEER
  ADMIN
  SUPER_ADMIN
  KIOSK
  // Scoped admin roles. What each one can reach is defined by the capability
  // map in src/lib/permissions.ts — never by comparing roles at the call site.
  CARE_MANAGER
  CHURCH_MANAGER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  // Optional company/organisation the supporter represents (unlocks corporate
  // volunteering). Set explicitly on their profile, or inferred from giving /
  // corporate volunteer history.
  company       String?
  role          UserRole  @default(VOLUNTEER)
  isActive      Boolean   @default(true)
  // Admin permission: may see donations, donors, funds, fundraisers & events
  // (the money/PII side). SUPER_ADMIN always can; grant to specific ADMINs.
  canViewDonations Boolean @default(false)
  // Display picture / avatar (may be a data URL, e.g. an uploaded sponsor logo).
  imageUrl      String?   @db.Text
  // Church member — sees church-only news, events & serving teams (in addition
  // to all Lighthouse Care content). Auto-set when they tithe; admin-toggleable.
  isChurchMember Boolean @default(false)
  // Staff member — an employee. Sees staff-only news, tasks, checklists and the
  // staff wellbeing/fitness challenges. A flag rather than a role, because staff
  // are usually volunteers and/or donors too and must keep those capabilities.
  isStaff        Boolean @default(false)
  // Trainee — supported employment/traineeship. Sees their hours, achievements,
  // required tasks and training modules, and can be assigned tasks with staff.
  isTrainee      Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  accounts            Account[]
  sessions            UserSession[]
  volunteerProfile    VolunteerProfile?
  adminNotes          AdminNote[]          @relation("NoteCreatedBy")
  emailLogs           EmailLog[]           @relation("EmailSentBy")
  passwordResetTokens PasswordResetToken[]

  // Donor & fundraising (additive — see docs/donor-portal-plan.md)
  donorProfile DonorProfile?
  donations    Donation[]
  sponsorships Sponsorship[]
  ticketOrders TicketOrder[]
  teamInterests TeamInterest[]
  fitnessEntries FitnessEntry[]
  fitnessLink    FitnessLink?
  cheers         ChallengeCheer[]
  extraEmails    UserEmail[]
  tasksAssigned  StaffTask[]           @relation("TaskAssignee")
  tasksCreated   StaffTask[]           @relation("TaskAssigner")
  checklistDone  ChecklistCompletion[]
}

// ─── Volunteer Profiles ───────────────────────────────────────────────────────

enum VolunteerStatus {
  PENDING_INDUCTION
  INDUCTED // legacy — no longer assigned; kept for DB compat
  ACTIVE
  INACTIVE
  ON_LEAVE // replaces PAUSED — volunteer-requested break
  PAUSED // legacy — no longer assigned; kept for DB compat
  SUSPENDED // admin-imposed hold (conduct, blue card, etc.)
  REMOVED
}

enum BlueCardStatus {
  NOT_APPLICABLE
  PENDING
  CURRENT
  EXPIRED
}

model VolunteerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personal details
  firstName    String
  lastName     String
  email        String
  mobile       String
  dateOfBirth  DateTime?
  addressLine1 String?
  addressLine2 String?
  suburb       String?
  state        String?
  postcode     String?

  // Emergency contact
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Status
  status            VolunteerStatus @default(PENDING_INDUCTION)
  joinedAt          DateTime        @default(now())
  lastActiveAt      DateTime?
  lastAttendedAt    DateTime?
  deactivatedAt     DateTime?
  deactivatedReason String?

  // Preferences
  preferredLocations String[]
  areasOfInterest    String[]
  notes              String?  @db.Text
  medicalNotes       String?  @db.Text
  accessibilityNeeds String?  @db.Text

  // Blue Card
  blueCardStatus BlueCardStatus @default(NOT_APPLICABLE)
  blueCardNumber String?
  blueCardExpiry DateTime?

  // Consents
  agreedToTerms       Boolean   @default(false)
  agreedToPrivacy     Boolean   @default(false)
  consentEmailUpdates Boolean   @default(false)
  consentSmsUpdates   Boolean   @default(false)
  agreedAt            DateTime?

  avatarUrl        String?
  inductionAnswers Json?

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability      VolunteerAvailability[]
  inductionProgress InductionProgress[]
  shiftAssignments  ShiftAssignment[]
  recurringBookings RecurringBooking[]
  shiftFeedback     ShiftFeedback[]
  attendanceRecords AttendanceRecord[]
  adminNotes        AdminNote[]
  emailLogs         EmailLog[]
  quizAnswers       InductionQuizAnswer[]

  @@index([status])
  @@index([lastAttendedAt])
  @@index([email])
}

// ─── Availability ─────────────────────────────────────────────────────────────

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimePeriod {
  PRE_OPEN // before 9:00 am
  MORNING // 9:00 am – 12:30 pm
  AFTERNOON // 12:30 pm onwards
  EVENING // kept for legacy compat
}

model VolunteerAvailability {
  id          String     @id @default(cuid())
  volunteerId String
  dayOfWeek   DayOfWeek
  timePeriod  TimePeriod // computed from startTime for display grouping
  startTime   String     @default("09:00") // HH:MM 24-hour, e.g. "09:00"
  endTime     String     @default("12:00") // HH:MM 24-hour, e.g. "12:00"
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, dayOfWeek, startTime])
  @@index([volunteerId])
}

// ─── Locations & Departments ──────────────────────────────────────────────────

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts            Shift[]
  attendance        AttendanceRecord[]
  guestAttendance   GuestAttendanceRecord[]
  recurringBookings RecurringBooking[]
  staffTasks        StaffTask[]
  checklistItems    ChecklistItem[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts Shift[]
}

// ─── Induction ────────────────────────────────────────────────────────────────

model InductionSection {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  sortOrder  Int      @default(0)
  isRequired Boolean  @default(true)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  progress InductionProgress[]
}

model InductionProgress {
  id          String    @id @default(cuid())
  volunteerId String
  sectionId   String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  section   InductionSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, sectionId])
}

model InductionQuizQuestion {
  id        String   @id @default(cuid())
  question  String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options InductionQuizOption[]
  answers InductionQuizAnswer[]
}

model InductionQuizOption {
  id         String  @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean @default(false)
  sortOrder  Int     @default(0)

  question InductionQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  InductionQuizAnswer[]
}

model InductionQuizAnswer {
  id          String   @id @default(cuid())
  volunteerId String
  questionId  String
  optionId    String
  isCorrect   Boolean
  answeredAt  DateTime @default(now())

  volunteer VolunteerProfile      @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  question  InductionQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option    InductionQuizOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, questionId])
}

// ─── Shifts & Rostering ───────────────────────────────────────────────────────

enum RecurringFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum ShiftAssignmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED_BY_VOLUNTEER
  ATTENDED
  NO_SHOW
  ADMIN_CANCELLED
}

model Shift {
  id           String   @id @default(cuid())
  locationId   String
  departmentId String?
  title        String?
  date         DateTime
  startTime    DateTime
  endTime      DateTime
  capacity     Int      @default(1)
  isRecurring  Boolean  @default(false)
  recurringId  String?
  notes        String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?

  location    Location          @relation(fields: [locationId], references: [id])
  department  Department?       @relation(fields: [departmentId], references: [id])
  assignments ShiftAssignment[]

  @@index([date])
  @@index([locationId])
}

model ShiftAssignment {
  id           String                @id @default(cuid())
  shiftId      String
  volunteerId  String
  status       ShiftAssignmentStatus @default(SCHEDULED)
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  createdById  String?

  shift     Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([shiftId, volunteerId])
  @@index([status])
}

// A volunteer's standing/recurring shift preference.
// When the cron generates new shifts it auto-books any active RecurringBookings
// that match the new shift's location, title and day of week.
model RecurringBooking {
  id          String             @id @default(cuid())
  volunteerId String
  locationId  String
  shiftTitle  String // e.g. "Morning Shift"
  dayOfWeek   Int // 1=Mon … 6=Sat (UTC day of the anchor shift)
  anchorDate  DateTime // Date of the first booked shift — used to calculate fortnightly/monthly cadence
  frequency   RecurringFrequency
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  location  Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@index([isActive])
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model AttendanceRecord {
  id           String    @id @default(cuid())
  volunteerId  String
  locationId   String?
  shiftId      String?
  signInAt     DateTime  @default(now())
  signOutAt    DateTime?
  durationMins Int?
  kioskName    String?
  ipAddress    String?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  location  Location?        @relation(fields: [locationId], references: [id])

  @@index([volunteerId])
  @@index([signInAt])
  @@index([locationId])
}

model GuestAttendanceRecord {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  mobile             String?
  email              String?
  volunteerArea      String?
  organisation       String?
  isCorporateDay     Boolean   @default(false)
  emergencyContact   String?
  safetyAcknowledged Boolean   @default(false)
  locationId         String?
  signInAt           DateTime  @default(now())
  signOutAt          DateTime?
  durationMins       Int?
  kioskName          String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  location Location? @relation(fields: [locationId], references: [id])

  @@index([signInAt])
}

// ─── Admin Notes ──────────────────────────────────────────────────────────────

model AdminNote {
  id          String   @id @default(cuid())
  volunteerId String
  content     String   @db.Text
  isInternal  Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  createdBy User             @relation("NoteCreatedBy", fields: [createdById], references: [id])
}

// ─── Email System ─────────────────────────────────────────────────────────────

enum EmailTemplateType {
  SIGNUP_CONFIRMATION
  INDUCTION_REMINDER
  INDUCTION_COMPLETE
  SHIFT_BOOKED
  VOLUNTEER_WELCOME
  SHIFT_REMINDER
  SHIFT_CANCELLED
  MISSED_SHIFT_FOLLOWUP
  INACTIVITY_CHECKIN
  ADMIN_NEW_VOLUNTEER
  ADMIN_REPEATED_NOSHOWS
  // Donor portal emails
  DONATION_RECEIPT
  DONOR_ACCOUNT_SETUP
  TICKET_CONFIRMATION
  DONOR_MIGRATION
  CUSTOM
}

model EmailTemplate {
  id        String            @id @default(cuid())
  type      EmailTemplateType @unique
  name      String
  subject   String
  bodyHtml  String            @db.Text
  bodyText  String?           @db.Text
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

model EmailLog {
  id           String             @id @default(cuid())
  to           String
  subject      String
  templateType EmailTemplateType?
  status       EmailStatus        @default(PENDING)
  sentAt       DateTime?
  errorMsg     String?
  volunteerId  String?
  sentById     String?
  metadata     Json?
  createdAt    DateTime           @default(now())

  volunteer VolunteerProfile? @relation(fields: [volunteerId], references: [id])
  sentBy    User?             @relation("EmailSentBy", fields: [sentById], references: [id])

  @@index([volunteerId])
  @@index([sentAt])
}

// ─── Password Reset ───────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── App Settings ─────────────────────────────────────────────────────────────

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  label     String?
  group     String?
  updatedAt DateTime @updatedAt

  @@index([group])
}

// ════════════════════════════════════════════════════════════════════════════
// DONOR & FUNDRAISING PORTAL
//
// All models below are ADDITIVE. They do not change any existing table and are
// not referenced by the volunteer portal, kiosk, or attendance features.
// Blueprint: docs/donor-portal-plan.md
// ════════════════════════════════════════════════════════════════════════════

enum DonationSource {
  DONATE_PAGE
  FUNDRAISER
  WORDPRESS_FORM
  APPEAL_LINK
  EVENT
  OFFLINE // manually recorded / imported (e.g. migrated from ShoutForGood)
}

enum SponsorshipStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum TicketOrderStatus {
  CONFIRMED
  CANCELLED
  REFUNDED
}

// ─── Donor profile (one per donor, optional) ──────────────────────────────────

model DonorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  displayName         String?
  phone               String?
  address             String?
  consentEmailUpdates Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Fund / designation (where the money goes) ────────────────────────────────

model Fund {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true)
  // When true, the public progress widget (raised vs goal) may be embedded for
  // this fund on lighthousecare.org.au. Independent of isActive so totals can be
  // shown/hidden without affecting whether the fund accepts gifts.
  showPublicProgress Boolean @default(false)
  // Which Stripe account this fund's gifts deposit to (e.g. "CARE" or "CHURCH").
  // Resolved to real keys in src/lib/stripe-accounts.ts. Falls back to CARE if
  // the chosen account isn't configured yet.
  depositAccount String @default("CARE")
  goalAmount  Decimal?  @db.Decimal(10, 2)
  // Per-fund giving amounts shown on the donate/give forms. Empty = use the
  // app defaults. suggestedAmount is the highlighted anchor; impactLabels maps
  // "amount" -> a short impact line (e.g. {"25":"a full trolley for a family"}).
  presetAmounts   Int[]   @default([])
  suggestedAmount Int?
  impactLabels    Json?
  defaultFrequency String? // once | weekly | fortnightly | monthly
  // Optional image + short tagline for the appeal card on the donor dashboard.
  imageUrl    String?
  tagline     String?
  // Feature this fund as an "appeal" on the donor dashboard (raised vs goal).
  showOnDashboard Boolean @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  donations    Donation[]
  fundraisers  Fundraiser[]
  events       Event[]
  sponsorships Sponsorship[]

  @@index([isActive])
}

// ─── Story / Good News (admin-managed content for the donor dashboard) ────────

model Story {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  category    String    @default("Good news") // Good news / Story / Update
  excerpt     String?   @db.Text
  imageUrl    String?
  externalUrl String? // link to the full article (e.g. the WordPress blog)
  isPublished Boolean   @default(false)
  // When true, only church members see this story.
  churchOnly  Boolean   @default(false)
  // Staff-only update — visible to staff/trainees, hidden from everyone else.
  staffOnly   Boolean   @default(false)
  publishedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished])
}

// ─── Church serving teams ("join a team") ─────────────────────────────────────
// Church volunteer opportunities (Creative/Worship, Host/Welcome, Kids Church…).
// Distinct from the Lighthouse Care volunteer roster. Church members can express
// interest in joining a team.
model ServingTeam {
  id          String         @id @default(cuid())
  name        String
  description String?        @db.Text
  imageUrl    String?
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  interests   TeamInterest[]

  @@index([isActive])
}

model TeamInterest {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  note      String?  @db.Text
  status    String   @default("INTERESTED") // INTERESTED | ACTIVE | DECLINED
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  team ServingTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

// ─── Donation (one row per completed gift) ────────────────────────────────────

model Donation {
  id                  String         @id @default(cuid())
  userId              String? // null until matched to an account by email
  donorEmail          String
  donorName           String?
  donorCompany        String? // optional company / organisation on the gift
  message             String?        @db.Text // optional public message shown on the donor wall
  amount              Decimal        @db.Decimal(10, 2)
  currency            String         @default("AUD")
  // Payment provider for this gift (e.g. STRIPE). Kept provider-neutral so a
  // gateway can change without a schema migration.
  provider              String       @default("STRIPE")
  // Null for offline / imported gifts (no gateway transaction). Unique when set.
  providerTransactionId String?      @unique
  fundId              String? // reconcilable; defaults to General once seeded
  fundraiserId        String?
  sponsorshipId       String?
  isRecurring         Boolean        @default(false)
  // Church tithe gift — kept separate from regular giving (excluded from the
  // dashboard total; managed in its own "Tithes" area). Deposits to CHURCH.
  isTithe             Boolean        @default(false)
  source              DonationSource @default(DONATE_PAGE)
  // Set when a gift originates from re-confirming a migrated recurring donor
  // (e.g. "shout_for_good"). Lets reporting tell migrated donors from new ones.
  migratedFrom        String?
  // Richer detail for the giving-history view (backfilled for imported gifts,
  // set on new gifts where known). All optional.
  description         String? // what the gift was for, e.g. "$25 Trolley"
  frequency           String? // One-off | Weekly | Fortnightly | Monthly
  paymentMethod       String? // e.g. Visa, Mastercard, Apple Pay, PayPal
  taxReceiptEligible  Boolean        @default(true)
  taxReceiptIssued    Boolean        @default(false)
  createdAt           DateTime       @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fund        Fund?        @relation(fields: [fundId], references: [id], onDelete: SetNull)
  fundraiser  Fundraiser?  @relation(fields: [fundraiserId], references: [id], onDelete: SetNull)
  sponsorship Sponsorship? @relation(fields: [sponsorshipId], references: [id], onDelete: SetNull)

  @@index([donorEmail])
  @@index([userId])
  @@index([fundId])
  @@index([fundraiserId])
  @@index([createdAt])
}

// ─── Sponsorship (recurring commitment) ───────────────────────────────────────

model Sponsorship {
  id                   String            @id @default(cuid())
  userId               String
  amount               Decimal           @db.Decimal(10, 2)
  frequency            String            @default("MONTHLY")
  fundId               String?
  provider             String            @default("STRIPE")
  // Provider reference for the recurring arrangement — with Stripe, the Stripe
  // Billing subscription id (native recurring; no scheduler of our own needed).
  providerSubscriptionRef String?        @unique
  status               SponsorshipStatus @default(ACTIVE)
  startedAt            DateTime          @default(now())
  cancelledAt          DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund      Fund?      @relation(fields: [fundId], references: [id], onDelete: SetNull)
  donations Donation[]

  @@index([userId])
  @@index([status])
}

// ─── Fundraiser (GoFundMe-style page) ─────────────────────────────────────────

model Fundraiser {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  storyHeading   String?   // optional heading above the story (e.g. "Building with Purpose")
  story          String    @db.Text
  contentBlocks  Json?     // rich sections below the story (image+text, video) — see the public page
  imageUrl       String?
  goalAmount     Decimal?  @db.Decimal(10, 2)
  raisedAmount   Decimal   @default(0) @db.Decimal(10, 2)
  organiserName  String
  organiserEmail String?
  fundId         String
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fund      Fund       @relation(fields: [fundId], references: [id])
  donations Donation[]

  @@index([fundId])
  @@index([isActive])
}

// ─── Event ticketing ──────────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @db.Text
  imageUrl    String?
  venue       String?
  startsAt    DateTime? // null = date To Be Advised (e.g. collecting sponsors early)
  endsAt      DateTime?
  fundId      String?
  capacity    Int?
  isPublished Boolean   @default(false)
  // When true, only church members see this event.
  churchOnly  Boolean   @default(false)
  // Optional per-event sections (e.g. the Good Food Festival).
  allowVolunteers   Boolean @default(false)
  volunteerCapacity Int?
  allowDonations    Boolean @default(false)
  allowSponsors     Boolean @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fund        Fund?         @relation(fields: [fundId], references: [id], onDelete: SetNull)
  ticketTypes TicketType[]
  orders      TicketOrder[]
  volunteers  EventVolunteer[]
  sponsors    EventSponsor[]

  @@index([fundId])
  @@index([isPublished])
}

enum SponsorTier {
  BRONZE
  SILVER
  GOLD
  FOOD_ACTIVITY
}

// Someone who signed up to volunteer at an event (distinct from the roster).
model EventVolunteer {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
}

// A business sponsoring an event (Bronze/Silver/Gold). Logo shows on the event
// page once paid. logoUrl may be a data URL uploaded at checkout.
model EventSponsor {
  id           String      @id @default(cuid())
  eventId      String
  userId       String?
  businessName String
  tier         SponsorTier
  amount       Decimal     @db.Decimal(10, 2)
  logoUrl      String?     @db.Text
  websiteUrl   String?
  contactName  String?
  contactEmail String?
  donationId   String?
  paid         Boolean     @default(false)
  createdAt    DateTime    @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model TicketType {
  id                String    @id @default(cuid())
  eventId           String
  name              String
  price             Decimal   @db.Decimal(10, 2)
  quantityAvailable Int?
  maxPerOrder       Int?
  salesStartAt      DateTime?
  salesEndAt        DateTime?
  sortOrder         Int       @default(0)

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([eventId])
}

model TicketOrder {
  id                  String            @id @default(cuid())
  userId              String? // matched by email
  purchaserName       String
  purchaserEmail      String
  eventId             String
  amountTotal         Decimal           @db.Decimal(10, 2)
  provider            String            @default("STRIPE")
  providerTransactionId String?         @unique
  status              TicketOrderStatus @default(CONFIRMED)
  createdAt           DateTime          @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([eventId])
  @@index([purchaserEmail])
  @@index([userId])
}

model Ticket {
  id           String    @id @default(cuid())
  orderId      String
  ticketTypeId String
  attendeeName String?
  reference    String    @unique
  checkedInAt  DateTime?

  order      TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@index([ticketTypeId])
}

// ─── Webhook audit / idempotency ──────────────────────────────────────────────

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String    @default("STRIPE")
  eventType       String
  providerEventId String    @unique
  payload         Json
  processedAt     DateTime?
  error           String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([provider])
  @@index([processedAt])
}

// A company's corporate volunteering session (past or logged). Matched to a
// supporter by their company name (see companyKey). Times/team sizes are free
// text because real rosters are messy ("TBC", "15+ 4 from council").
model CorporateVolunteerSession {
  id           String    @id @default(cuid())
  companyName  String
  companyKey   String // normalised companyName, for matching
  date         DateTime?
  timeLabel    String?
  teamSize     String?
  contactName  String?
  contactEmail String?
  notes        String?   @db.Text
  source       String? // e.g. "Christmas Blitz 2025"
  createdById  String? // user who manually added it (null = imported)
  createdAt    DateTime  @default(now())

  @@index([companyKey])
}

// ─── Staff wellbeing / fitness challenges ─────────────────────────────────────
//
// A collective, staff-only challenge (e.g. "10 million steps in September").
// Steps are entered by hand: device sync would mean per-provider OAuth, and
// Apple Health has no server API at all — not worth the complexity here.
model FitnessChallenge {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  unit      String   @default("steps")
  goal      Int // collective target, e.g. 10,000,000
  // Designed banner for the staff dashboard. When set it replaces the built-in
  // artwork, so the campaign can be re-skinned without a deploy.
  imageUrl  String?
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  entries FitnessEntry[]
  cheers  ChallengeCheer[]

  @@index([isActive])
}

// One row per person per day, so re-entering a day corrects it rather than
// double-counting.
model FitnessEntry {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  day         DateTime @db.Date
  amount      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge FitnessChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, day])
  @@index([challengeId])
  @@index([userId])
}

// Rotating encouragement shown to staff — one per day, cycled by date.
/**
 * Opt-in link between a staff member and their phone's health data.
 *
 * Apple Health can't be read from a web page — HealthKit is native-only — so
 * the phone pushes to us instead: an iOS Shortcut reads today's step count and
 * POSTs it with this token. Nothing exists until the person creates it, and
 * revoking is a single row update.
 *
 * The token is write-only by design: it can add a step count for its owner and
 * nothing else. It reads no personal data, so a leaked token means someone
 * could fudge one person's step tally — annoying, not harmful — and it can be
 * regenerated from the fitness page at any time.
 */
model FitnessLink {
  id         String    @id @default(cuid())
  userId     String    @unique
  token      String    @unique
  source     String    @default("Apple Health") // whatever set it up
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  lastAmount Int?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([revokedAt])
}

/**
 * A recurring staff wellbeing session — the weekly health schedule.
 *
 * Times are plain strings on purpose ("11:30"). These are wall-clock slots in a
 * printed-on-the-fridge sense, not instants: nobody wants "Tuesday 11:30" to
 * drift because of a timezone conversion.
 */
/**
 * An extra email address on an account.
 *
 * The primary address stays on `User.email` — this table holds only the
 * additional ones, so nothing that already reads `user.email` changes meaning.
 * Someone might sign up with their work address and later give with a personal
 * one; linking the two brings the giving history together.
 *
 * A row is worthless until `verifiedAt` is set. Verification is what proves the
 * person actually controls the address, and nothing — no donation claiming, no
 * merging — happens before it.
 */
model UserEmail {
  id             String    @id @default(cuid())
  userId         String
  email          String    @unique
  verifiedAt     DateTime?
  token          String?   @unique
  tokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verifiedAt])
}

/**
 * A note left on the challenge page for the day.
 *
 * Deliberately short-lived: only today's are shown, and yesterday's are deleted
 * by the daily cron. A wall that accumulates goes stale and stops being read,
 * whereas one that empties every night stays worth looking at, and it lowers
 * the stakes of posting.
 */
model ChallengeCheer {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  body        String   @db.Text
  /** The Brisbane calendar day this belongs to. */
  day         DateTime @db.Date
  createdAt   DateTime @default(now())

  challenge FitnessChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId, day])
  @@index([userId])
}

model WellbeingSession {
  id        String   @id @default(cuid())
  title     String
  weekday   Int // 1 = Monday … 7 = Sunday
  startTime String // "11:30", 24-hour
  endTime   String? // optional — some sessions just have a start
  location  String?
  leader    String?
  notes     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, weekday])
}

model WellbeingTip {
  id        String   @id @default(cuid())
  body      String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

// ─── Post-shift feedback ──────────────────────────────────────────────────────
//
// After a volunteer signs out we email them a one-tap 5-star rating. The row is
// created at sign-out with no rating yet; the emailed links carry an unguessable
// token, so nobody can rate on someone else's behalf or enumerate shifts.
model ShiftFeedback {
  id           String    @id @default(cuid())
  token        String    @unique
  volunteerId  String
  attendanceId String?   @unique
  rating       Int? // 1–5
  comment      String?   @db.Text
  ratedAt      DateTime?
  createdAt    DateTime  @default(now())

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@index([rating])
}

// ─── Staff tasks & recurring checklists ───────────────────────────────────────

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

// A one-off job assigned to a staff member or trainee ("take the cardboard bins
// out for the truck"). Assignment emails the person; overdue ones are chased.
model StaffTask {
  id           String       @id @default(cuid())
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  dueAt        DateTime?
  locationId   String?
  assignedToId String? // null = anyone on shift can pick it up
  assignedById String
  completedAt  DateTime?
  completedById String?
  remindedAt   DateTime? // last overdue chase, so we nag once a day at most
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy User      @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([assignedToId])
  @@index([dueAt])
}

enum ChecklistFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// The *definition* of a recurring cleaning/maintenance job. Occurrences aren't
// pre-generated: each period is identified by a computed key (see periodKey in
// src/lib/checklists.ts), so a missing completion row means "not done yet".
model ChecklistItem {
  id          String             @id @default(cuid())
  title       String
  description String?            @db.Text
  frequency   ChecklistFrequency @default(DAILY)
  locationId  String? // null = applies everywhere
  // Hard deadline inside the period — "HH:MM" Brisbane. Past this, it's overdue.
  dueTime     String?
  // WEEKLY: 1 = Monday … 7 = Sunday. MONTHLY: day of month.
  weekday     Int?
  dayOfMonth  Int?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())

  location    Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  completions ChecklistCompletion[]

  @@index([isActive])
  @@index([frequency])
}

model ChecklistCompletion {
  id            String   @id @default(cuid())
  itemId        String
  // Identifies the occurrence: "2026-09-03" daily, "2026-W36" weekly, "2026-09" monthly.
  periodKey     String
  completedById String
  completedAt   DateTime @default(now())
  note          String?  @db.Text

  item        ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  completedBy User          @relation(fields: [completedById], references: [id], onDelete: Cascade)

  @@unique([itemId, periodKey])
  @@index([periodKey])
}
